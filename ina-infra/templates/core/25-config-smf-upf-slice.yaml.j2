apiVersion: ref.nephio.org/v1alpha1
kind: Config
metadata:
  name: smf-core-upf-slice-{{ n }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/part-of: ina-infra
    app.kubernetes.io/component: dedicated-core
    ina-infra.nephio.lab/slice: "{{ n }}"
spec:
  config:
    apiVersion: workload.nephio.org/v1alpha1
    kind: NFDeployment
    metadata:
      name: upf-slice-{{ n }}
      namespace: {{ upf_namespace }}
    spec:
      provider: upf.openairinterface.org
      capacity:
        maxDownlinkThroughput: 5G
        maxUplinkThroughput: 5G
      interfaces:
      - name: n3
        ipv4:
          address: {{ upf_n3 }}/{{ prefix_len }}
          gateway: {{ gateway }}
        vlanID: 4
      - name: n4
        ipv4:
          address: {{ upf_n4 }}/{{ prefix_len }}
          gateway: {{ gateway }}
        vlanID: 2
      - name: n6
        ipv4:
          address: {{ upf_n6 }}/{{ prefix_len }}
          gateway: {{ gateway }}
        vlanID: 3
      networkInstances:
      - name: vpc-internal
        interfaces:
        - n4
      - name: vpc-internet
        dataNetworks:
        - name: oai{{ n }}
          pool:
          - prefix: {{ dnn_cidr }}
        interfaces:
        - n6
      - name: vpc-ran
        interfaces:
        - n3
