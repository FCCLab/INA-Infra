apiVersion: workload.nephio.org/v1alpha1
kind: NFDeployment
metadata:
  name: smf-core
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/part-of: ina-infra
    app.kubernetes.io/component: dedicated-core
spec:
  provider: smf.openairinterface.org
  capacity:
    maxNFConnections: {{ max_nf_connections }}
    maxSessions: {{ max_sessions | default(500) }}
  interfaces:
  - name: n4
    ipv4:
      address: {{ smf_n4 }}/{{ prefix_len }}
      gateway: {{ gateway }}
    vlanID: 2
  networkInstances:
  - name: vpc-internal
    interfaces:
    - n4
  parametersRefs:
  - name: smf-core-config
    apiVersion: workload.nephio.org/v1alpha1
    kind: NFConfig
{% for sl in slices %}
  - name: smf-core-upf-slice-{{ sl.n }}
    apiVersion: ref.nephio.org/v1alpha1
    kind: Config
{% endfor %}
