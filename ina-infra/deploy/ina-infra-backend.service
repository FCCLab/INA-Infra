[Unit]
Description=INA-Infra PlanningLayer API (host; Gurobi academic license)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fcp
Group=fcp
WorkingDirectory=/home/fcp/nephio-network-slicing/ina-infra
Environment=HOME=/home/fcp
Environment=INA_INFRA_ROOT=/home/fcp/nephio-network-slicing/ina-infra
Environment=INA_SRC=/home/fcp/nephio-network-slicing/algorithm/new_implementation
Environment=REPOS_DIR=/home/fcp/nephio-network-slicing/repos
Environment=PUSH_SCRIPT=/home/fcp/nephio-network-slicing/ina-infra/backend/scripts/push_git_repos.sh
Environment=SSH_CFG=/home/fcp/nephio-network-slicing/ina-infra/backend/scripts/ssh_config
Environment=GRB_LICENSE_FILE=/home/fcp/gurobi.lic
Environment=PYTHONPATH=/home/fcp/nephio-network-slicing/ina-infra/backend
Environment=INA_DB_PATH=/home/fcp/nephio-network-slicing/ina-infra/data/profiles.db
Environment=GITEA_HOST=10.1.132.200
Environment=GITEA_PORT=3000
Environment=GITEA_USER=nephio
Environment=GITEA_PASS=secret
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8082
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
