# Physical AI dashboard sidecar (HF token + vLLM UI) — linux/amd64.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:/root/.local/bin:${PATH} \
    DASHBOARD_STATIC=/app/static

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl python3 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && /root/.local/bin/uv venv --python 3.12 --seed --managed-python /opt/venv \
    && /root/.local/bin/uv pip install --python /opt/venv fastapi uvicorn

WORKDIR /app
COPY backend/app.py /app/app.py
COPY frontend-console/static /app/static

EXPOSE 80
CMD ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port ${DASHBOARD_PORT:-80}"]
