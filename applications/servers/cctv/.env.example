# ---------------------------------------------------------------------------
# Slice A environment. Copy to .env and adjust per host.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Stream identity (must match on both hosts) ----------------------------
STREAM_PATH=slicea
HTTP_PORT=8080
# tcp keeps a single OUTBOUND (NAT/firewall-robust) connection from the UE;
# udp is optional but needs an RTCP UDP pinhole through the UPF.
RTSP_PROTOCOL=tcp

# --- OTA network (5G data-plane interface) ---------------------------------
# UE-push model: the edge analyzer RUNS the RTSP RECORD server on EDGE_OTA_IP
# (rtsp://EDGE_OTA_IP:RTSP_PORT/STREAM_PATH) and the publisher (UE) pushes to it
# with an outbound connection -- so it works from behind the UPF/N6 NAT.
# PUBLISHER_OTA_IP is the UE's own OTA address (source of the uplink stream).
PUBLISHER_OTA_IP=10.45.0.20
EDGE_OTA_IP=10.45.0.10
# Parent host interface for the macvlan OTA network (container side).
OTA_PARENT_IFACE=ens1
OTA_SUBNET=10.45.0.0/24
OTA_GATEWAY=10.45.0.1
# In-container interface names used by entrypoint wait/health logic.
OTA_IFACE=eth0
METRICS_IFACE=

# --- Video source (client) -------------------------------------------------
# File path (looped) or a camera device such as /dev/video0.
VIDEO_SOURCE=/data/sample.mp4
FPS=25
WIDTH=1280
HEIGHT=720
BITRATE_KBPS=4000

# --- Analyzer / YOLO (edge) ------------------------------------------------
YOLO_ENABLED=true
YOLO_MODEL=yolov8n.pt
# auto lets ultralytics pick CUDA when available; force with cuda:0 or cpu.
YOLO_DEVICE=cuda:0
# One OS process + YOLO model per camera (parallel CPU/GPU). Set false to share.
YOLO_PROCESS_PER_CLIENT=true
FRAME_SKIP=1
RTSP_LATENCY_MS=0
# torch wheel index used at image build time. CUDA 12.1 wheel by default;
# use https://download.pytorch.org/whl/cpu for CPU-only edge hosts.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121

# --- Metrics (exposed on ens0 / bridge, never OTA) -------------------------
CLIENT_METRICS_PORT=9101
EDGE_METRICS_PORT=9102
METRICS_ADDR=0.0.0.0
LOG_INTERVAL_S=1

# --- Clock / chrony --------------------------------------------------------
# Optional host running chronyd that containers query with `chronyc -h`.
CHRONYC_HOST=
CHRONY_MAX_OFFSET_MS=5
