# IoT UE console: Python backend (MQTT over PDU) + Frontend Console (UI) — linux/amd64.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:/root/.local/bin:${PATH} \
    DASHBOARD_STATIC=/app/frontend-console/static

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl iproute2 iputils-ping python3 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && /root/.local/bin/uv venv --python 3.12 --seed --managed-python /opt/venv \
    && /root/.local/bin/uv pip install --python /opt/venv fastapi uvicorn pydantic prometheus-client 'paho-mqtt>=2.1,<3'

WORKDIR /app
COPY backend/ /app/backend/
COPY frontend-console/ /app/frontend-console/
COPY entrypoint.sh /app/entrypoint.sh

RUN chmod +x /app/entrypoint.sh

EXPOSE 80 8090
ENTRYPOINT ["/app/entrypoint.sh"]
