# ---------------------------------------------------------------------------
# hd-stream environment. Copy to .env and adjust per host.
#   cp .env.example .env
# ---------------------------------------------------------------------------

STREAM_PATH=hdstream
RTSP_PORT=8556
# tcp keeps a single OUTBOUND (NAT/firewall-robust) connection from the UE.
RTSP_PROTOCOL=tcp

VIDEO_SOURCE=/data/source.mp4
FPS=25
WIDTH=1280
HEIGHT=720
BITRATE_KBPS=4000

RTSP_LATENCY_MS=0

CLIENT_METRICS_PORT=9111
SERVER_METRICS_PORT=9112
METRICS_ADDR=0.0.0.0
LOG_INTERVAL_S=1

CHRONYC_HOST=
CHRONY_MAX_OFFSET_MS=5
