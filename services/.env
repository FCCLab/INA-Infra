# Physical interface for DNS and DHCP (host network — broadcasts reach the LAN)
ENP1S0_PARENT=enp1s0

# Static IPv4 on the host for enp1s0 (Pi-hole uses host networking)
PIHOLE_HOST_IP=10.1.132.200
PIHOLE_HOST_PREFIX=24

# L2/L3 segment on enp1s0
SUBNET=10.1.132.0/24
GATEWAY=10.1.132.1
DOMAIN=nephio.lab

# DHCP lease pool (avoids mgmt MetalLB VIPs 10–99 and node IPs 200+)
DHCP_RANGE_START=10.1.132.100
DHCP_RANGE_END=10.1.132.199
DHCP_LEASE_TIME=12h

# Pi-hole
TZ=UTC
PIHOLE_WEB_PASSWORD=changeme
PIHOLE_UPSTREAM_DNS=8.8.8.8
