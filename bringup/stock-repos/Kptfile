apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: stock-repos
  annotations:
    config.kubernetes.io/local-config: "true"
upstream:
  type: git
  git:
    repo: https://github.com/nephio-project/catalog
    directory: /nephio/optional/stock-repos
    ref: origin/main
  updateStrategy: resource-merge
upstreamLock:
  type: git
  git:
    repo: https://github.com/nephio-project/catalog
    directory: /nephio/optional/stock-repos
    ref: origin/main
    commit: origin/main
info:
  description: Some stock external repositories to start with
