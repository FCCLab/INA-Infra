apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: rootsync
  annotations:
    config.kubernetes.io/local-config: "true"
upstream:
  type: git
  git:
    repo: https://github.com/nephio-project/catalog
    directory: /nephio/optional/rootsync
    ref: origin/main
  updateStrategy: resource-merge
upstreamLock:
  type: git
  git:
    repo: https://github.com/nephio-project/catalog
    directory: /nephio/optional/rootsync
    ref: origin/main
    commit: origin/main
info:
  description: Provisions rootsync to configure configsync for a Nephio cluster
pipeline:
  mutators:
    - image: ghcr.io/kptdev/krm-functions-catalog/starlark:v0.4.3
      configPath: set-values.yaml
